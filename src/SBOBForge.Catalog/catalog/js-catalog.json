{
  "id": "js",
  "version": 1,
  "rules": [
    { "id": "js.cp.exec",           "kind": "execShell",       "receiver": "",              "method": "exec" },
    { "id": "js.cp.execsync",       "kind": "execShell",       "receiver": "",              "method": "execSync" },
    { "id": "js.cp.execfile",       "kind": "execProgramArgs", "receiver": "",             "method": "execFile" },
    { "id": "js.cp.execfilesync",   "kind": "execProgramArgs", "receiver": "",             "method": "execFileSync" },
    { "id": "js.cp.spawn",          "kind": "execProgramArgs", "receiver": "",             "method": "spawn" },
    { "id": "js.cp.spawnsync",      "kind": "execProgramArgs", "receiver": "",             "method": "spawnSync" },
    { "id": "js.qualified.cp.exec",     "kind": "execShell",       "receiver": "child_process", "method": "exec" },
    { "id": "js.qualified.cp.execsync", "kind": "execShell",       "receiver": "child_process", "method": "execSync" },
    { "id": "js.qualified.cp.execfile", "kind": "execProgramArgs", "receiver": "child_process", "method": "execFile" },
    { "id": "js.qualified.cp.spawn",    "kind": "execProgramArgs", "receiver": "child_process", "method": "spawn" },

    { "id": "js.fs.readfile",       "kind": "open",            "receiver": "fs",   "method": "readFile",       "flags": [ "O_RDONLY" ] },
    { "id": "js.fs.readfilesync",   "kind": "open",            "receiver": "fs",   "method": "readFileSync",   "flags": [ "O_RDONLY" ] },
    { "id": "js.fs.writefile",      "kind": "open",            "receiver": "fs",   "method": "writeFile",      "flags": [ "O_WRONLY", "O_CREAT", "O_TRUNC" ] },
    { "id": "js.fs.writefilesync",  "kind": "open",            "receiver": "fs",   "method": "writeFileSync",  "flags": [ "O_WRONLY", "O_CREAT", "O_TRUNC" ] },
    { "id": "js.fs.appendfile",     "kind": "open",            "receiver": "fs",   "method": "appendFile",     "flags": [ "O_WRONLY", "O_CREAT", "O_APPEND" ] },
    { "id": "js.fs.appendfilesync", "kind": "open",            "receiver": "fs",   "method": "appendFileSync", "flags": [ "O_WRONLY", "O_CREAT", "O_APPEND" ] },
    { "id": "js.fs.open",           "kind": "openModeString",  "receiver": "fs",   "method": "open" },
    { "id": "js.fs.opensync",       "kind": "openModeString",  "receiver": "fs",   "method": "openSync" },
    { "id": "js.bare.readfile",     "kind": "open",            "receiver": "",    "method": "readFile",       "flags": [ "O_RDONLY" ] },
    { "id": "js.bare.readfilesync", "kind": "open",            "receiver": "",    "method": "readFileSync",   "flags": [ "O_RDONLY" ] },
    { "id": "js.bare.writefile",    "kind": "open",            "receiver": "",    "method": "writeFile",      "flags": [ "O_WRONLY", "O_CREAT", "O_TRUNC" ] },
    { "id": "js.bare.writefilesync", "kind": "open",           "receiver": "",    "method": "writeFileSync",  "flags": [ "O_WRONLY", "O_CREAT", "O_TRUNC" ] },
    { "id": "js.bare.appendfile",   "kind": "open",            "receiver": "",    "method": "appendFile",     "flags": [ "O_WRONLY", "O_CREAT", "O_APPEND" ] },
    { "id": "js.bare.appendfilesync", "kind": "open",          "receiver": "",    "method": "appendFileSync", "flags": [ "O_WRONLY", "O_CREAT", "O_APPEND" ] },
    { "id": "js.bare.unlink",       "kind": "unrepresentable", "receiver": "",    "method": "unlink",         "unrepresentablePrimitive": "delete" },
    { "id": "js.bare.unlinksync",   "kind": "unrepresentable", "receiver": "",   "method": "unlinkSync",     "unrepresentablePrimitive": "delete" },
    { "id": "js.bare.rm",           "kind": "unrepresentable", "receiver": "",   "method": "rm",             "unrepresentablePrimitive": "delete" },
    { "id": "js.bare.rmsync",       "kind": "unrepresentable", "receiver": "",   "method": "rmSync",         "unrepresentablePrimitive": "delete" },
    { "id": "js.bare.rmdir",        "kind": "unrepresentable", "receiver": "",   "method": "rmdir",          "unrepresentablePrimitive": "delete" },
    { "id": "js.bare.rmdirsync",    "kind": "unrepresentable", "receiver": "",   "method": "rmdirSync",       "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.unlink",         "kind": "unrepresentable", "receiver": "fs",  "method": "unlink",        "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.unlinksync",     "kind": "unrepresentable", "receiver": "fs",  "method": "unlinkSync",    "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.rm",             "kind": "unrepresentable", "receiver": "fs",  "method": "rm",            "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.rmsync",         "kind": "unrepresentable", "receiver": "fs",  "method": "rmSync",        "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.rmdir",          "kind": "unrepresentable", "receiver": "fs",  "method": "rmdir",         "unrepresentablePrimitive": "delete" },
    { "id": "js.fs.rmdirsync",      "kind": "unrepresentable", "receiver": "fs",  "method": "rmdirSync",     "unrepresentablePrimitive": "delete" },

    { "id": "js.fetch",             "kind": "egress",          "receiver": "",     "method": "fetch" },
    { "id": "js.http.request",      "kind": "egress",          "receiver": "http",  "method": "request" },
    { "id": "js.http.get",          "kind": "egress",          "receiver": "http",  "method": "get" },
    { "id": "js.https.request",    "kind": "egress",          "receiver": "https", "method": "request" },
    { "id": "js.https.get",         "kind": "egress",          "receiver": "https", "method": "get" },

    { "id": "js.net.listen",        "kind": "ingress",         "receiver": null,   "method": "listen" }
  ]
}
