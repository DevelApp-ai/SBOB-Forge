<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SBOBForge.Core\SBOBForge.Core.csproj" />
    <ProjectReference Include="..\SBOBForge.Parsing\SBOBForge.Parsing.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.DotNet\SBOBForge.Adapters.DotNet.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Java\SBOBForge.Adapters.Java.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Python\SBOBForge.Adapters.Python.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Go\SBOBForge.Adapters.Go.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.TypeScript\SBOBForge.Adapters.TypeScript.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Php\SBOBForge.Adapters.Php.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.PowerShell\SBOBForge.Adapters.PowerShell.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Bash\SBOBForge.Adapters.Bash.csproj" />
    <ProjectReference Include="..\SBOBForge.Adapters.Cxx\SBOBForge.Adapters.Cxx.csproj" />
    <ProjectReference Include="..\SBOBForge.Catalog\SBOBForge.Catalog.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SBOB-Registry #27: the shipped single-file self-contained binary is
         `sbobforge` (linux) / `sbobforge.exe` (win-x64) — AssemblyName drives
         the apphost name on every RID; without this the apphost is
         SBOBForge.Cli and the release assets fail to package. -->
    <AssemblyName>sbobforge</AssemblyName>
  </PropertyGroup>

</Project>
