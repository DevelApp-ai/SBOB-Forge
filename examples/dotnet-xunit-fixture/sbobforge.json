{
  "packageType": "nuget",
  "packageName": "Example.Core",
  "packageVersion": "1.0.0",
  "namespace": "develapp",
  "targetOs": "linux",
  "architectures": [ "amd64" ],
  "sutGlobs": [ "sut/**/*.cs" ],
  "testGlobs": [ "tests/**/*.cs" ],
  "pathPolicies": [
    { "match": "%PackageRoot%", "emit": "/app/⋯", "prefix": true },
    { "id": "snapshot-temp-dir", "match": "tempRoot", "emit": "/tmp/⋯" }
  ],
  "netPolicies": [
    { "id": "forwarded-request-url", "match": "targetUrl", "emit": "⋯" }
  ],
  "execPathPolicy": {
    "git": "/usr/bin/git"
  },
  "allowParseError": []
}
