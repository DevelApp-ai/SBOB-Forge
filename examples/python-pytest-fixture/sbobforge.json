{
  "packageType": "pypi",
  "packageName": "example-py-core",
  "packageVersion": "1.0.0",
  "namespace": "develapp",
  "targetOs": "linux",
  "architectures": [ "amd64" ],
  "sutGlobs": [ "sut/**/*.py" ],
  "testGlobs": [ "tests/**/*.py" ],
  "pathPolicies": [
    { "match": "%PackageRoot%", "emit": "/app/⋯", "prefix": true },
    { "id": "snapshot-temp-dir", "match": "temp_root", "emit": "/tmp/⋯" }
  ],
  "netPolicies": [
    { "id": "forwarded-request-url", "match": "target_url", "emit": "⋯" }
  ],
  "execPathPolicy": {
    "git": "/usr/bin/git"
  },
  "allowParseError": []
}
