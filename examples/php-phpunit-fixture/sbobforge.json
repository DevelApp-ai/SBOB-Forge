{
  "packageType": "composer",
  "packageName": "example/php-core",
  "packageVersion": "1.0.0",
  "namespace": "develapp",
  "targetOs": "linux",
  "architectures": [ "amd64" ],
  "sutGlobs": [ "sut/**/*.php" ],
  "testGlobs": [ "tests/**/*.php" ],
  "pathPolicies": [
    { "match": "%PackageRoot%", "emit": "/app/⋯", "prefix": true }
  ],
  "execPathPolicy": {
    "git": "/usr/bin/git"
  },
  "allowParseError": []
}
